# Merge ONLY these settings into the existing private production Compose .env.
# Do not replace unrelated Neon/Temporal/SendGrid settings.
CLICKHOUSE_USER=dittofeed
# REQUIRED: generate a unique 32-byte password with: openssl rand -hex 32
# Paste privately, never into Git, chat, shell history or logs. Empty fails closed.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_CONTAINER_MEM_LIMIT=2048
# Leave CLICKHOUSE_HOST unset: Compose defaults to http://clickhouse-server:8123
