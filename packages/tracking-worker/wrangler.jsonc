{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsletter-tracking",
  "account_id": "2c0f822ce2342b56b3998e7981c03332",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-09",
  "workers_dev": false,
  "preview_urls": false,
  // Local/default configuration remains off and has no routes. Only production
  // attaches the dedicated tracking-only dittotrx.com SaaS zone, never the app.
  "vars": {
    "ENABLED": "false",
    "ENABLE_OPEN_TRACKING_DEV_LAKE": "false"
  },
  // Local verification needs no public KV namespace. The production environment
  // below pins its separately provisioned RONIN namespace.
  "kv_namespaces": [
    { "binding": "NETWORK_SETS" }
  ],
  // Resources are provisioned separately; deployment only binds these names.
  "queues": {
    "producers": [
      { "binding": "TRACKING_QUEUE", "queue": "newsletter-tracking" }
    ],
    "consumers": [
      {
        "queue": "newsletter-tracking",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "newsletter-tracking-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["0 3 * * 1"]
  },
  "env": {
    "production": {
      "name": "newsletter-tracking",
      // Backend-ready development capture approved; sender workers remain off.
      "vars": {
        "ENABLED": "true",
        "ENABLE_OPEN_TRACKING_DEV_LAKE": "true",
        "TRACKING_ORIGIN": "https://email.roninpublishing.com",
        "CLOUDFLARE_TRACKING_CNAME_TARGET": "dt.dittotrx.com"
      },
      "kv_namespaces": [
        { "binding": "NETWORK_SETS", "id": "d5abe2270b984ab69e5e5029797cc37b" }
      ],
      "queues": {
        "producers": [
          { "binding": "TRACKING_QUEUE", "queue": "newsletter-tracking" }
        ],
        "consumers": [
          {
            "queue": "newsletter-tracking",
            "max_batch_size": 50,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "dead_letter_queue": "newsletter-tracking-dlq"
          }
        ]
      },
      // Cloudflare-for-SaaS Worker-as-origin requires a catch-all in this zone.
      // The explicit friendly target also covers orange-to-orange CNAME routing.
      "routes": [
        { "pattern": "*/*", "zone_id": "a8a65a84a6701e6d9dcc8b617e7b4659" },
        { "pattern": "dt.dittotrx.com/*", "zone_id": "a8a65a84a6701e6d9dcc8b617e7b4659" }
      ]
    }
  },
  // TRACKING_ORIGIN must be an operator-configured HTTPS origin (no path).
  // Set OPEN_TRACKING_RELAY_SECRET using Wrangler's secret store, never vars.
  // Local development may explicitly set LOCAL_DEVELOPMENT=true and a loopback
  // HTTP origin. Incoming HTTP is then restricted to dt.*.localhost hosts.
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  }
}
